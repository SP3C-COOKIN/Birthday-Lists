generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RequestStatus {
  Accepted
  Pending
  Rejected
}

model User {
  id Int @id @default(autoincrement())
  username String @unique
  email String @unique
  password String


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BirthdayLists {
  id String @id @default(autoincrement())
  name String
  description String?
  
  creatorId String

  Membership String
  birthdaysData Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model 